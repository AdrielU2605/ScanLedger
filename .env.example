# ScanLedger environment configuration.
# Copy this file to .env and edit as needed. This file contains NO real secrets
# and is the only environment file committed to the repository.

# --- Server bind -------------------------------------------------------------
# ScanLedger binds to loopback by default. Binding to any non-loopback address
# requires the explicit acknowledgement below (PRD 8.4).
SCANLEDGER_BIND_HOST=127.0.0.1
SCANLEDGER_BIND_PORT=8000
SCANLEDGER_ALLOW_NON_LOOPBACK_BIND=false

# --- Database ----------------------------------------------------------------
SCANLEDGER_DATABASE_URL=sqlite+aiosqlite:///./scanledger.db

# --- CVE providers -----------------------------------------------------------
# Optional. Without a key, the NVD public rate limit applies; a key only raises
# that limit. ScanLedger builds and runs with no key at all.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
